# Contact form — email delivery via Resend (https://resend.com)
# 1. Create a Resend account, verify the octava.cloud domain (DNS records shown in Resend).
# 2. Create an API key and add these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=marcelo@octava.cloud
# Use a verified-domain sender once octava.cloud is verified in Resend:
CONTACT_FROM_EMAIL="Octava Website <hello@octava.cloud>"
